# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# generated Prisma client
packages/gateway/src/generated/

# secrets — .env.example is committed, .env never is (Phase 1 deliverable)
.env
.env.local
.env.*.local
!.env.example

# logs / traces
*.log
npm-debug.log*
packages/agent-client/traces/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# test + coverage
coverage/

# docker volume data
# docker-compose.yml uses Docker-managed NAMED volumes (postgres-data, redis-data),
# which live under /var/lib/docker/volumes and never touch this directory. These
# patterns are defensive: they only matter if someone switches to bind mounts.
/postgres-data/
/redis-data/
/.docker-data/

# reference agent local artifacts
packages/agent-client/.agent-keystore.json
packages/agent-client/traces/

# playwright / screenshot artifacts
.playwright-mcp/
*.png
!docs/screenshots/*.png

# Next.js agent-rules files, auto-generated by `next dev` when it detects an AI coding
# agent. Generic framework notices, not project documentation. Scoped to this workspace
# on purpose — another workspace may legitimately want its own hand-written AGENTS.md.
packages/dashboard/AGENTS.md
packages/dashboard/CLAUDE.md

# Auto-regenerated by Next.js on every dev/build run, and its contents point into
# .next/ (already ignored) — build output in this Next.js version, not stable source
# config. Regeneration is verified: Next recreates it from scratch on both dev and
# build with no manual step. Scoped, like the rules above.
packages/dashboard/next-env.d.ts

# Recording cheat sheet — contains a live merchant API key. NEVER commit.
video-recording-cheatsheet.md
