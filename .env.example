# ---------------------------------------------------------------------------
# AgentGateway — environment template (COMMITTED).
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed (Phase 1 deliverable: "secrets never committed").
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port the Fastify gateway binds on when run on the host (npm run dev).
# The containerised gateway in docker-compose.yml binds 3001 so the two can
# run side by side without a port clash.
PORT=3000

# Postgres — matches the credentials in docker-compose.yml.
# Host processes use localhost; the gateway container uses host `postgres`.
DATABASE_URL=postgresql://agentgateway:agentgateway@localhost:5432/agentgateway?schema=public

# Redis — nonces, locks, idempotency fast path (§3.2, §3.3).
REDIS_URL=redis://localhost:6379

# Razorpay TEST MODE credentials — https://dashboard.razorpay.com (Test Mode)
# → Settings → API Keys. Test keys start with `rzp_test_`.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Razorpay webhook signing secret — Settings → Webhooks → the secret you set
# when registering the endpoint. Used for HMAC-SHA256 verification (§3.4).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
