# ---------------------------------------------------------------------------
# AgentGateway — environment template (COMMITTED).
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed (Phase 1 deliverable: "secrets never committed").
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port the Fastify gateway binds on when run on the host (npm run dev).
# The containerised gateway in docker-compose.yml binds 3001 so the two can
# run side by side without a port clash.
PORT=3000

# Postgres — matches the credentials in docker-compose.yml.
# Host processes use localhost; the gateway container uses host `postgres`.
DATABASE_URL=postgresql://agentgateway:agentgateway@localhost:5432/agentgateway?schema=public

# Redis — nonces, locks, idempotency fast path (§3.2, §3.3).
REDIS_URL=redis://localhost:6379

# Razorpay TEST MODE credentials — https://dashboard.razorpay.com (Test Mode)
# → Settings → API Keys. Test keys start with `rzp_test_`.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Razorpay webhook signing secret — Settings → Webhooks → the secret you set
# when registering the endpoint. Used for HMAC-SHA256 verification (§3.4).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---------------------------------------------------------------------------
# Reference agent (packages/agent-client, Phase 4)
# ---------------------------------------------------------------------------

# OpenRouter API key — https://openrouter.ai/keys
# Powers the agent's reasoning layer (NVIDIA Nemotron 3 Ultra, free tier) via
# OpenRouter's OpenAI-compatible endpoint. Only needed to run the reference
# agent; the gateway itself does not use it.
# Without it, run the agent with --deterministic to use the offline picker.
OPENROUTER_API_KEY=your_openrouter_key_here

# ---------------------------------------------------------------------------
# Phase 4.5 — merchant authentication, secret encryption, rate limiting
# ---------------------------------------------------------------------------

# AES-256-GCM master key encrypting merchants.razorpay_key_secret_encrypted at rest.
# Base64 of 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every previously-stored merchant secret undecryptable.
MERCHANT_SECRET_ENCRYPTION_KEY=generate_a_base64_32_byte_key_here

# Rate limits. Merchant limits are keyed per API key on /v1/merchant/*; agent limits
# are keyed per agent identity on the payment-facing routes.
RATE_LIMIT_MERCHANT_MAX=120
RATE_LIMIT_MERCHANT_WINDOW_MS=60000
RATE_LIMIT_AGENT_MAX=60
RATE_LIMIT_AGENT_WINDOW_MS=60000
