{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGateway Fastify service \u2014 protocol router, adapters, policy engine, Razorpay settlement.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "razorpay:smoke": "tsx scripts/create-test-order.ts",
    "webhook:test": "tsx scripts/send-test-webhook.ts",
    "demo:protocols": "tsx scripts/demo-protocols.ts",
    "checkout:live": "tsx scripts/create-live-checkout.ts",
    "merchant:create": "tsx scripts/create-merchant.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ioredis": "^5.11.1",
    "razorpay": "^2.9.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
