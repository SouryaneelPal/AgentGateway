{
  "name": "agent-client",
  "version": "0.1.0",
  "private": true,
  "description": "Reference AI buyer agent \u2014 purchases the same cart over x402 and AP2 (Phase 4).",
  "type": "module",
  "bin": {
    "agent-client": "./dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "setup": "tsx src/index.ts setup",
    "agent": "tsx src/index.ts run",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "main": "dist/src/index.js"
}
